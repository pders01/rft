{
  "name": "refract",
  "version": "0.1.0",
  "description": "Author once in neutral plaintext; derive consumer-specific artifacts (Claude skills, MCP tool defs, docs).",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "refract": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsx src/cli.ts build",
    "sync": "tsx src/cli.ts install",
    "check": "tsx src/cli.ts check",
    "clean": "tsx src/cli.ts clean",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "consola": "^3.2.3",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
